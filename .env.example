# Copy this file to .env in your own instance (never commit .env — it's git-ignored).
# JobOS reads all of this from .env at the repo root. Leave a variable blank/absent
# if you're not using that source or integration.

# ── Tracking sheet (the single source of truth) ─────────────────────────────
# Leave empty on first run — JobOS will create the sheet once and write its ID
# back here. From then on this value is ALWAYS reused; JobOS never creates a
# second tracking sheet for an existing instance.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=

# Google Drive folder to store generated resumes/cover letters in (optional —
# if empty, generated files are kept in local-data/applications/ instead).
GOOGLE_DRIVE_APPLICATIONS_FOLDER_ID=

# Path to a Google service-account JSON key, shared with edit access on the
# tracking sheet. Only needed if you run scripts/sheet_sync.py standalone
# (e.g. from cron via run_daily.py). Not needed if the agent updates the
# sheet live through the Google Drive MCP connection instead.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── API-based job sources ────────────────────────────────────────────────────
# Broad aggregators
JOBSPIPE_API_KEY=
OPENINGS_API_KEY=

# Any other REST job-search API (RapidAPI job boards, YC/Work at a Startup API,
# a custom aggregator, etc.) — add one KEY per source you wire up in
# local-data/config/sources.json, named to match the "env_key" field there.
# Example:
# YCOMBINATOR_JOBS_API_KEY=

# ── Browser-based sources (no public API) ────────────────────────────────────
# No keys needed — these are scraped live via the Claude in Chrome extension,
# which must be connected and logged into these sites:
#   Wellfound, Instahyre, LinkedIn Jobs
# Nothing to configure here; see local-data/config/sources.json for toggles.

# ── Outreach ──────────────────────────────────────────────────────────────
# No key needed if using the Gmail MCP connection for drafting outreach emails.
